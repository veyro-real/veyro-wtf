---
// status.veyro.wtf. The checks run in the browser against the bot's own
// endpoints, so this page has no server of its own and cannot go down with
// the thing it reports on.
import Base from '../layouts/Base.astro';

const CHECKS = [
  { label: 'Bot app',          detail: 'Next app on Railway',            path: '/',                      method: 'GET'  },
  { label: 'Telegram intake',  detail: 'Rejects unsigned calls',         path: '/api/telegram/webhook',  method: 'POST' },
  { label: 'State API',        detail: 'Reads through to Supabase',      path: '/api/state',             method: 'GET'  },
];
---
<Base title="Veyro — status" description="Live reachability of the Veyro bot and its endpoints." noindex>
  <div class="wrap navwrap"><nav class="nav">
    <a class="logo" href="https://veyro.wtf"><img src="/logo.png" alt="Veyro" width="378" height="120" /></a>
    <div class="nav-side"><a class="lnk" href="https://veyro.wtf">Back to veyro.wtf</a></div>
  </nav></div>

  <div class="wrap" style="max-width:860px">
    <header class="status-head">
      <h1>System status</h1>
      <p class="status-lede"><span class="beacon wait" id="beacon"></span><span id="summary">Running checks…</span></p>
    </header>

    <div class="checks" id="checks">
      {CHECKS.map((c) => (
        <div class="check" data-path={c.path} data-method={c.method} data-state="wait">
          <div>
            <h2>{c.label}</h2>
            <p>{c.detail}</p>
            <code>{c.method} {c.path}</code>
          </div>
          <span class="check-state"><span class="beacon wait"></span><span class="txt">Checking</span></span>
        </div>
      ))}
    </div>

    <footer class="status-foot">
      <p class="warn">Reachability only. These run from your browser, so a failure can equally mean
        your own network cannot reach the service. They do not yet prove Supabase, the Solana RPC or
        the launch feed are healthy — that needs a health endpoint on the bot, which is not built.</p>
      <p id="stamp"></p>
    </footer>
  </div>

  <script>
    const ORIGIN = 'https://veyro-live-production-9ac9.up.railway.app';
    const rows = [...document.querySelectorAll('.check')];
    const beacon = document.getElementById('beacon');
    const summary = document.getElementById('summary');

    function mark(el, state, text) {
      el.dataset.state = state;
      const dot = el.querySelector('.check-state .beacon');
      dot.className = 'beacon ' + state;
      el.querySelector('.check-state .txt').textContent = text;
    }

    async function run() {
      let up = 0;
      await Promise.all(rows.map(async (el) => {
        try {
          // An opaque no-cors response proves the host answered. That is the
          // most an anonymous cross-origin check can honestly claim.
          await fetch(ORIGIN + el.dataset.path, { method: el.dataset.method, mode: 'no-cors', cache: 'no-store' });
          mark(el, 'up', 'Reachable'); up++;
        } catch {
          mark(el, 'down', 'Unreachable');
        }
      }));
      const all = up === rows.length;
      beacon.className = 'beacon ' + (all ? 'up' : up ? 'down' : 'down');
      summary.textContent = all
        ? 'All endpoints reachable.'
        : `${up} of ${rows.length} endpoints reachable.`;
      document.getElementById('stamp').textContent =
        'Last checked ' + new Date().toLocaleTimeString() + ' · rechecks every 60s';
    }
    run();
    setInterval(run, 60000);
  </script>
</Base>
